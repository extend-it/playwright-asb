# Copy to .env before running the tests: cp .env.example .env
# SAS_KEY_VALUE is the emulator's own placeholder key, not a secret. Never put a real
# Service Bus connection string in this file - use it only against the local emulator.
SERVICEBUS_CONNECTION_STRING="Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"

# Entity names, as declared in docker/Config.json
SB_TOPIC=security-alerts
SB_QUEUE=incident-actions
